---
// リンクの小さなボタン。url が空なら「準備中」として押せない見た目で出す
// （リンク先が空のボタンを本物のように見せないため）。
interface Props {
	label: string;
	url?: string;
	/** 読み上げ用の説明（例: 「『ランタナ』を YouTube で見る」） */
	ariaLabel?: string;
}
const { label, url, ariaLabel } = Astro.props;
const isExternal = !!url && /^https?:\/\//.test(url);
---

{
	url ? (
		<a class="pill" href={url} aria-label={ariaLabel} {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}>
			{label}
		</a>
	) : (
		<span class="pill pill--pending" aria-disabled="true" title="リンク先は準備中です">
			{label}
			<small>準備中</small>
		</span>
	)
}
