---
// サイト共通レイアウト（WO-SITE-01 のトップ試作レイアウトを全ページ共通化：WO-SITE-02）
// ヘッダー（ブランド＋ハリネズミ＋ナビ）とフッター（リンク集）は全ページ共通。
import '../styles/site.css';
import faviconUrl from '../assets/favicon.ico?url';
import touchIconUrl from '../assets/apple-touch-icon-180x180.png?url';
import SiteHeader, { type PageKey } from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

interface Props {
	title: string;
	description: string;
	page: PageKey;
	/** フッターのリンク集を出すか（Contact はページ本文にリンク集があるので出さない） */
	footerLinks?: boolean;
}
const { title, description, page, footerLinks = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f2ebe6" />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<link rel="icon" href={faviconUrl} sizes="32x32" />
		<link rel="apple-touch-icon" href={touchIconUrl} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="site">
		<p class="proto-note">試作版です（デザイン検討中）</p>
		<SiteHeader page={page} />
		<slot />
		<SiteFooter showLinks={footerLinks} />
		<script>
			import '../scripts/hedgehogs.ts';
		</script>
	</body>
</html>
