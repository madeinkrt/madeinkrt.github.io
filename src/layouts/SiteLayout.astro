---
// サイト共通レイアウト（WO-SITE-01 のトップ試作レイアウトを全ページ共通化：WO-SITE-02）
// ヘッダー（ブランド＋ハリネズミ＋ナビ）とフッター（リンク集）は全ページ共通。
// OGP 画像・ファビコンは public/ に固定名で置く（WO-SITE-03）。
//   ogp.jpg：杉山の原画（diecut_sugiyama.psd）を紙色の 1200×630 に配置したもの
//   favicon.ico / favicon-32x32.png / apple-touch-icon.png：MV の正面スプライト（ヘッダーと同じ絵）
import '../styles/site.css';
import SiteHeader, { type PageKey } from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

interface Props {
	title: string;
	description: string;
	page: PageKey;
	/** フッターのリンク集を出すか（Contact はページ本文にリンク集があるので出さない） */
	footerLinks?: boolean;
	/** 検索結果に出さないページ（404 など）。canonical / og:url も出さない */
	noindex?: boolean;
	/** ページ固有の OGP 画像（作品ページのジャケットなど）。未指定なら共通の ogp.jpg */
	ogImage?: { src: string; width: number; height: number; alt: string };
}
const { title, description, page, footerLinks = true, noindex = false, ogImage: pageOgImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = pageOgImage
	? { ...pageOgImage, src: new URL(pageOgImage.src, Astro.site) }
	: { src: new URL('/ogp.jpg', Astro.site), width: 1200, height: 630, alt: 'おなかを見せて笑うハリネズミの杉山' };
// 正方形に近い画像（ジャケット）は横長カードだと上下が切れるので、小さいカード表示にする
const twitterCard = og.width / og.height >= 1.5 ? 'summary_large_image' : 'summary';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f2ebe6" />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:site_name" content="榑田いつき｜KURETA Itsuki" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:image" content={og.src} />
		<meta property="og:image:width" content={String(og.width)} />
		<meta property="og:image:height" content={String(og.height)} />
		<meta property="og:image:alt" content={og.alt} />
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={og.src} />
		<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="site">
		<SiteHeader page={page} />
		<slot />
		<SiteFooter showLinks={footerLinks} />
		<script>
			import '../scripts/hedgehogs.ts';
		</script>
	</body>
</html>
