---
// Contact（連絡先）：メールとリンク集。問い合わせフォームは置かない。
// 有償依頼の受付文言は入れない（Service 廃止の決定どおり）。
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteLinks from '../components/site/SiteLinks.astro';

const mail = 'madeinkrt@gmail.com';
---

<SiteLayout
	title="Contact 連絡先｜榑田いつき KURETA Itsuki"
	description="榑田いつき（KURETA Itsuki）の連絡先とリンク集。"
	page="contact"
	footerLinks={false}
>
	<main class="page-main">
		<h1 class="section__heading page-title">
			<span class="section__en" lang="en">CONTACT</span>
			<span class="section__ja">連絡先</span>
		</h1>

		<section class="page-section" aria-labelledby="mail-heading">
			<h2 class="sub-heading" id="mail-heading"><span lang="en">Mail</span>メール</h2>
			<div class="panel mail">
				<p class="mail__lead">ご連絡はメールでお願いします。</p>
				<p class="mail__address"><a href={`mailto:${mail}`}>{mail}</a></p>
			</div>
		</section>

		<section class="page-section" aria-labelledby="feedback-heading">
			<h2 class="sub-heading" id="feedback-heading"><span lang="en">Messages</span>感想・メッセージについて</h2>
			<div class="panel feedback">
				<p>感想やメッセージは、ありがたく読んでいます。</p>
				<p>返信は、できるときにできる分だけです。返信がない場合も、読んでいないわけではありません。</p>
				<p>制作に関する連絡は、メールでお願いします。</p>
			</div>
		</section>

		<section class="page-section" aria-labelledby="links-heading">
			<h2 class="sub-heading" id="links-heading"><span lang="en">Links</span>リンク集</h2>
			<SiteLinks variant="full" />
		</section>
	</main>
</SiteLayout>
