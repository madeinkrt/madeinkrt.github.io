---
// トップページ（WO-SITE-01 試作 → WO-SITE-02 でデータ反映）
// 作品・お知らせ・リンクはすべて src/content/ と src/data/ のデータから読む。
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import PeekHedgehog from '../components/top/PeekHedgehog.astro';
import SleepyHedgehog from '../components/top/SleepyHedgehog.astro';
import FloatingMotifs from '../components/top/FloatingMotifs.astro';
import WorkCard from '../components/top/WorkCard.astro';
import belly from '../assets/hedgehog/belly.png';
import { getWorks } from '../lib/data';

const { released, targeted, untargeted } = await getWorks();
// 目標表記のある制作中作品の先頭を NEXT RELEASE に、残りを「その先に」に出す。
// 目標表記のない制作中作品（日程未定）は、日程を出さずに「ほかに制作中」に出す。
const [next, ...later] = targeted;
const NextContent = next ? (await render(next)).Content : null;

const news = (await getCollection('news'))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id))
	.slice(0, 3);
const newsRendered = await Promise.all(news.map(async (n) => ({ entry: n, Content: (await render(n)).Content })));

const fmtDate = (d: Date) => `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}`;
---

<SiteLayout
	title="榑田いつき｜KURETA Itsuki 公式サイト"
	description="榑田いつき（KURETA Itsuki）の公式サイト。音楽・イラスト・アニメーションの作品をまとめています。"
	page="home"
>
	<main class="top-main">
		{
			(next || untargeted.length > 0) && (
				<section class="section next" aria-labelledby="next-heading" data-inview>
					<h2 class="section__heading" id="next-heading">
						<span class="section__en" lang="en">NEXT RELEASE</span>
						<span class="section__ja">次の作品</span>
					</h2>
					{next && (
						<div class="next-card">
							<div class="next-card__visual">
								<FloatingMotifs />
								<Image class="next-card__img" src={belly} alt="おなかを見せてくつろぐハリネズミの杉山" width={200} densities={[1, 2]} />
							</div>
							<div class="next-card__body">
								{next.data.label && <p class="next-card__label" lang="en">{next.data.label}</p>}
								<p class="next-card__title">『{next.data.title}』</p>
								{next.data.target && <p class="target-badge">{next.data.target}</p>}
								{NextContent && <div class="next-card__text"><NextContent /></div>}
							</div>
						</div>
					)}
					{
						later.length > 0 && (
							<ul class="later-list">
								{later.map((w) => (
									<li>
										<span class="later-list__lead">その先に</span>
										{w.data.label && <span lang="en">{w.data.label}</span>}
										<span class="later-list__title">『{w.data.title}』</span>
										{w.data.target && <span class="target-badge target-badge--small">{w.data.target}</span>}
									</li>
								))}
							</ul>
						)
					}
					{
						untargeted.length > 0 && (
							<ul class="wip-list" aria-label="ほかに制作中の作品">
								{untargeted.map((w) => (
									<li class="wip-item">
										<span class="wip-item__jacket jacket-placeholder" role="img" aria-label="ジャケット画像は準備中です">
											<span>JACKET</span>
											<small>準備中</small>
										</span>
										<span class="wip-item__body">
											<span class="later-list__lead">ほかに制作中</span>
											{w.data.label && <span class="wip-item__label" lang="en">{w.data.label}</span>}
											<span class="later-list__title">『{w.data.title}』</span>
										</span>
									</li>
								))}
							</ul>
						)
					}
				</section>
			)
		}

		<section class="section music" aria-labelledby="music-heading" data-peek-area>
			<h2 class="section__heading" id="music-heading">
				<span class="section__en" lang="en">MUSIC</span>
				<span class="section__ja">これまでの作品</span>
			</h2>
			<div class="work-grid">
				{released.map((w) => <WorkCard work={w} />)}
			</div>
			<p class="more-link"><a href="/works/">作品一覧へ<span aria-hidden="true"> →</span></a></p>
			<PeekHedgehog />
		</section>

		<section class="section news" aria-labelledby="news-heading">
			<h2 class="section__heading" id="news-heading">
				<span class="section__en" lang="en">NEWS</span>
				<span class="section__ja">お知らせ</span>
			</h2>
			<div class="news-box">
				<ul class="news-list">
					{
						newsRendered.map(({ entry, Content }) => (
							<li class="news-item">
								<time datetime={entry.data.date.toISOString().slice(0, 10)}>{fmtDate(entry.data.date)}</time>
								<p class="news-item__title">{entry.data.title}</p>
								<div class="news-item__text">
									<Content />
								</div>
							</li>
						))
					}
				</ul>
				<SleepyHedgehog />
			</div>
		</section>
	</main>
</SiteLayout>
